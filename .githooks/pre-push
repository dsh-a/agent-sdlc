#!/usr/bin/env bash
# Runs scrub-gate on everything being pushed. Enable: git config core.hooksPath .githooks
set -uo pipefail
z40=0000000000000000000000000000000000000000
root="$(git rev-parse --show-toplevel)"
gate="$root/scripts/scrub-gate.sh"
[ -f "$gate" ] || exit 0

rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue            # branch deletion — nothing to scan
  if [ "$remote_sha" = "$z40" ]; then
    range=""                                        # new branch — scan tree only
  else
    range="$remote_sha..$local_sha"
  fi
  bash "$gate" "$local_sha" "$range" || rc=1
done
exit $rc
