# OpenRouter provider config for agent-sdlc (omp target).
#
# Copy to ~/.omp/agent/models.yml. You may copy ONLY the `providers:` block —
# everything below it is optional, and the model list is the part that rots.
#
# ── THE SHORT VERSION ────────────────────────────────────────────────────────
#
# Name the provider id directly in .omp/config.yml's modelRoles. No tier labels,
# no equivalence mapping, nothing to keep in sync:
#
#   modelRoles:
#     slow:    openrouter/qwen/qwen3.8-2.4t-a95b     # orchestrator, verify, review
#     default: openrouter/deepseek/deepseek-v4-pro   # implementation agents
#     task:    openrouter/deepseek/deepseek-v4-pro
#     smol:    openrouter/openai/gpt-oss-20b         # monitor, pre-digest, supervisor
#
# Verified 2026-09-21: `openrouter/qwen/qwen3.8-flash` resolves and answers with
# no entry anywhere in models.yml. omp reads the live OpenRouter catalogue, so
# declaring models here duplicates something it already knows.
#
# ── WHY THIS FILE SHRANK ─────────────────────────────────────────────────────
#
# A deployed models.yml carried three defects at once, none of which errored:
# `deepseek/deepseek-v4-pro` declared twice with contextWindows of 1,048,576 and
# 200,000; equivalence mapping it to `claude-sonnet-4-5` while config.yml asked
# for `claude-sonnet-4-6`, so the mapping silently did not apply; and no opus
# override at all, leaving the orchestrator's own `slow:` role unresolved.
#
# All three are drift between a hand-written copy and a live catalogue. The fix
# is to stop keeping the copy. `tests/models_config.py` guards what remains and
# can be run against a live file:
#
#   python3 tests/models_config.py ~/.omp/agent/models.yml
#
# ── PICKING A MODEL ──────────────────────────────────────────────────────────
#
#   omp models openrouter          # what is actually available right now
#   omp models find <pattern>      # search the live catalogue
#
# Size the role against the measured peaks in
# docs/internal/agent-requirement-profiles.md, not against price: `slow` carries
# the orchestrator at 375k p90, so it needs a genuinely large window.
#
# The blocks below are kept as a reference for the rarer case where a canonical
# tier id must resolve to a specific provider model. They are commented out, and
# a file containing only `providers:` is a working file.

providers:
  openrouter:
    baseUrl: https://openrouter.ai/api/v1
    api: openai-completions
    apiKey: OPENROUTER_API_KEY        # env-var-name or literal
    authHeader: true
    models:
      # ── opus tier (slow role: orchestrator, verify, review) ──────────
      # Uncomment ONE. For Claude models, cacheControlFormat: anthropic enables
      # prompt caching (reduces cost on the orchestrator's repeated system prompt).
      # Uncomment ONE:
      # - id: anthropic/claude-opus-4.6
      #   name: Claude Opus 4.6 (OpenRouter)
      #   reasoning: true
      #   input: [text, image]
      #   contextWindow: 200000
      #   maxTokens: 32000
      #   compat:
      #     openRouterRouting:
      #       only: [anthropic]        # pin to Anthropic upstream — no quality degradation
      #     cacheControlFormat: anthropic
      # - id: openai/gpt-5-codex
      #   name: GPT-5 Codex (OpenRouter)
      #   reasoning: true
      #   input: [text, image]
      #   contextWindow: 200000
      #   maxTokens: 16000
      #   compat:
      #     openRouterRouting:
      #       order: [openai]          # prefer OpenAI upstream
      # - id: x-ai/grok-4
      #   name: Grok 4 (OpenRouter)
      #   reasoning: true
      #   input: [text, image]
      #   contextWindow: 200000
      #   maxTokens: 16000

      # ── sonnet tier (default/task role: implementation agents) ────────
      # Uncomment ONE:
      # - id: anthropic/claude-sonnet-4.5
      #   name: Claude Sonnet 4.5 (OpenRouter)
      #   reasoning: true
      #   input: [text, image]
      #   contextWindow: 200000
      #   maxTokens: 16000
      #   compat:
      #     openRouterRouting:
      #       only: [anthropic]
      #     cacheControlFormat: anthropic
      # - id: openai/gpt-5.1
      #   name: GPT-5.1 (OpenRouter)
      #   reasoning: true
      #   input: [text, image]
      #   contextWindow: 200000
      #   maxTokens: 16000
      # - id: google/gemini-2.5-pro
      #   name: Gemini 2.5 Pro (OpenRouter)
      #   reasoning: true
      #   input: [text, image]
      #   contextWindow: 1000000
      #   maxTokens: 65536

      # ── haiku tier (smol role: monitor, preflight, supervisor) ────────
      # Uncomment ONE. For this tier, consider providers.openrouterVariant: nitro
      # (fastest inference — these agents are latency-sensitive) or floor (cheapest).
      # Uncomment ONE:

      # - id: anthropic/claude-haiku-4.5
      #   name: Claude Haiku 4.5 (OpenRouter)
      #   input: [text, image]
      #   contextWindow: 200000
      #   maxTokens: 8192
      #   compat:
      #     openRouterRouting:
      #       only: [anthropic]
      #     cacheControlFormat: anthropic
      # - id: google/gemini-2.5-flash
      #   name: Gemini 2.5 Flash (OpenRouter)
      #   reasoning: true
      #   input: [text, image]
      #   contextWindow: 1000000
      #   maxTokens: 65536
      # - id: deepseek/deepseek-chat
      #   name: DeepSeek Chat (OpenRouter)
      #   input: [text]
      #   contextWindow: 128000
      #   maxTokens: 8192

# Map each uncommented OpenRouter model to its canonical tier id.
# omp coalesces these so modelRoles in .omp/config.yml resolve correctly.
equivalence:
  overrides:
    # opus tier → claude-opus-4-6
    # openrouter/anthropic/claude-opus-4.6: claude-opus-4-6
    # openrouter/openai/gpt-5-codex: claude-opus-4-6
    # openrouter/x-ai/grok-4: claude-opus-4-6
    # sonnet tier → claude-sonnet-4-5
    # openrouter/anthropic/claude-sonnet-4.5: claude-sonnet-4-5
    # openrouter/openai/gpt-5.1: claude-sonnet-4-5
    # openrouter/google/gemini-2.5-pro: claude-sonnet-4-5
    # haiku tier → claude-haiku-4-5
    # openrouter/anthropic/claude-haiku-4.5: claude-haiku-4-5
    # openrouter/google/gemini-2.5-flash: claude-haiku-4-5
    # openrouter/deepseek/deepseek-chat: claude-haiku-4-5

# ── OpenRouter extraBody (optional, per-model) ─────────────────────────
# The compat.extraBody field sends arbitrary top-level fields to OpenRouter
# on every request. Use for team-specific gateway hints or controller selectors.
# Add to any model's compat block (see the opus tier models above for the slot):
#
#   compat:
#     extraBody:
#       gateway: m1-01        # route to a specific provider pool
#       controller: mlx       # pin to a specific provider controller
