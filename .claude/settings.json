{
  "permissions": {
    "allow": [
      "Bash(flutter test*)",
      "Bash(flutter analyze*)",
      "Bash(flutter pub*)",
      "Bash(git *)",
      "Bash(gh pr*)",
      "Bash(gh api*)",
      "Bash(gh run*)",
      "Bash(gh workflow*)",
      "Bash(ls *)",
      "Bash(bash .claude/skills/cycle/open-terminal.sh*)",
      "Bash(python3 .claude/skills/cycle/clear-agent-states.py*)",
      "Bash(bash .claude/skills/cycle/start-parallel-cycles.sh*)",
      "Bash(bash .claude/skills/cycle/sync-gitignore.sh*)",
      "Bash(bash .claude/skills/cycle/run-suite.sh*)",
      "Bash(bash .claude/skills/cycle/publish-branch.sh*)",
      "Bash(bash .claude/skills/cycle/reap-clones.sh*)",
      "Bash(python3 .claude/skills/cycle/aggregate-telemetry.py*)",
      "Bash(python3 .claude/skills/cycle/gate-report.py*)",
      "Bash(python3 .claude/skills/cycle/prune-analyzer-baselines.py*)",
      "Bash(python3 .claude/skills/evidence/evidence.py*)",
      "Bash(python3 ~/.claude/skills/cycle/clear-agent-states.py*)",
      "Bash(python3 ~/.claude/skills/cycle/aggregate-telemetry.py*)",
      "Bash(python3 ~/.claude/skills/cycle/gate-report.py*)",
      "Bash(python3 ~/.claude/skills/cycle/prune-analyzer-baselines.py*)",
      "Bash(python3 ~/.claude/skills/evidence/evidence.py*)",
      "Bash(python3 .claude/skills/cycle/config-get.py*)",
      "Bash(python3 ~/.claude/skills/cycle/config-get.py*)",
      "Bash(python3 .claude/skills/cycle/suite-result.py*)",
      "Bash(python3 ~/.claude/skills/cycle/suite-result.py*)",
      "Bash(bash .claude/skills/cycle/preflight-deploy.sh*)",
      "Bash(bash ~/.claude/skills/cycle/preflight-deploy.sh*)",
      "Bash(python3 .claude/skills/harness-intake/findings-extract.py*)",
      "Bash(python3 .claude/skills/refine/probes.py*)",
      "Bash(python3 ~/.claude/skills/refine/probes.py*)",
      "Bash(python3 .claude/skills/refine/story.py*)",
      "Bash(python3 ~/.claude/skills/refine/story.py*)",
      "Bash(python3 ~/.claude/skills/harness-intake/findings-extract.py*)",
      "mcp__company-a-docs__*",
      "mcp__codebase-rag__*"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-secrets.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.py"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/log-event.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-log.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-log.py"
          }
        ]
      }
    ]
  }
}
